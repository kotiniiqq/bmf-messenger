NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

DATABASE_URL=postgres://bmf:bmf@localhost:5432/bmf
REDIS_URL=redis://localhost:6379

# openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-32-characters-minimum-000
JWT_REFRESH_SECRET=change-me-32-characters-minimum-111

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=bmfminio
S3_SECRET_KEY=bmfminio-secret
S3_BUCKET=bmf-media

MAIL_DOMAINS=bmf.ink

# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# SENTRY_DSN=

# npm run geoip -w server downloads this; it is not in the repository.
GEOIP_DB_PATH=./data/dbip-city-lite.mmdb

# Browser origins allowed to call the API.
CORS_ORIGINS=bmf://app,http://localhost:5173,http://localhost:4173
